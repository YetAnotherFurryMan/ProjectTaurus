bin = build

rule cc
  command = gcc -c $in -o $out -Wall -Wextra -Wpedantic $flags -std=gnu17 -Iinclude

rule cxx
  command = g++ -c $in -o $out -Wall -Wextra -Wpedantic $flags -std=gnu++17 -Iinclude

rule link
  command = g++ $in -o $out -Wall -Wextra -Wpedantic -Wl,-rpath,../lib $flags -std=gnu++17 -L$bin

rule lib
  command = ar qc $out $in

rule testc
  command = gcc $in -o $out -Wall -Wextra -Wpedantic $flags -std=gnu17 -Iinclude -ggdb

rule testcxx
  command = g++ $in -o $out -Wall -Wextra -Wpedantic $flags -std=gnu++17 -Iinclude -ggdb

build $bin/obj/ap/ap.c.o: cc src/ap/ap.c
  flags = -fPIC
build $bin/lib/libap.a: lib $bin/obj/ap/ap.c.o

build $bin/lib/ap.so: link $bin/obj/ap/ap.c.o
  flags = --shared

build $bin/obj/vec/vec.c.o: cc src/vec/vec.c
  flags = -fPIC
build $bin/lib/libvec.a: lib $bin/obj/vec/vec.c.o

build $bin/lib/vec.so: link $bin/obj/vec/vec.c.o
  flags = --shared

build $bin/obj/assoc/assoc.c.o: cc src/assoc/assoc.c
  flags = -fPIC
build $bin/lib/libassoc.a: lib $bin/obj/assoc/assoc.c.o

build $bin/lib/assoc.so: link $bin/obj/assoc/assoc.c.o
  flags = --shared

build $bin/obj/pgm/pgm.c.o: cc src/pgm/pgm.c
  flags = -fPIC
build $bin/lib/libpgm.a: lib $bin/obj/pgm/pgm.c.o

build $bin/lib/pgm.so: link $bin/obj/pgm/pgm.c.o
  flags = --shared

build $bin/obj/error/strings.c.o: cc src/error/strings.c
  flags = -fPIC
build $bin/obj/error/error.c.o: cc src/error/error.c
  flags = -fPIC
build $bin/lib/liberror.a: lib $bin/obj/error/strings.c.o $bin/obj/error/error.c.o

build $bin/lib/error.so: link $bin/obj/error/strings.c.o $bin/obj/error/error.c.o
  flags = --shared

build $bin/obj/horn/load.c.o: cc src/horn/load.c
  flags = -fPIC
build $bin/obj/horn/lex.c.o: cc src/horn/lex.c
  flags = -fPIC
build $bin/obj/horn/init.c.o: cc src/horn/init.c
  flags = -fPIC
build $bin/obj/horn/emit.c.o: cc src/horn/emit.c
  flags = -fPIC
build $bin/lib/libhorn.a: lib $bin/obj/horn/load.c.o $bin/obj/horn/lex.c.o $bin/obj/horn/init.c.o $bin/obj/horn/emit.c.o

build $bin/lib/horn.so: link $bin/obj/horn/load.c.o $bin/obj/horn/lex.c.o $bin/obj/horn/init.c.o $bin/obj/horn/emit.c.o
  flags = --shared

build $bin/obj/trs.cg.nasm_x86/cg.c.o: cc src/trs.cg.nasm_x86/cg.c
  flags = -fPIC
build $bin/lib/libtrs.cg.nasm_x86.a: lib $bin/obj/trs.cg.nasm_x86/cg.c.o

build $bin/lib/trs.cg.nasm_x86.so: link $bin/obj/trs.cg.nasm_x86/cg.c.o
  flags = --shared

build $bin/obj/trs.cg.lisp/cg.c.o: cc src/trs.cg.lisp/cg.c
  flags = -fPIC
build $bin/lib/libtrs.cg.lisp.a: lib $bin/obj/trs.cg.lisp/cg.c.o

build $bin/lib/trs.cg.lisp.so: link $bin/obj/trs.cg.lisp/cg.c.o
  flags = --shared

build $bin/obj/trsiron.trs/iron.c.o: cc src/trsiron.trs/iron.c
  flags = -fPIC
build $bin/obj/trsiron.trs/lex.c.o: cc src/trsiron.trs/lex.c
  flags = -fPIC
build $bin/lib/libtrsiron.trs.a: lib $bin/obj/trsiron.trs/iron.c.o $bin/obj/trsiron.trs/lex.c.o

build $bin/lib/trsiron.trs.so: link $bin/obj/trsiron.trs/iron.c.o $bin/obj/trsiron.trs/lex.c.o
  flags = --shared

build $bin/obj/trsbee.c/bee.c.o: cc src/trsbee.c/bee.c
  flags = -fPIC
build $bin/lib/libtrsbee.c.a: lib $bin/obj/trsbee.c/bee.c.o

build $bin/lib/trsbee.c.so: link $bin/obj/trsbee.c/bee.c.o
  flags = --shared

build $bin/obj/horn_tool/main.c.o: cc src/horn_tool/main.c
  flags = -fPIE
build $bin/bin/horn_tool: link $bin/obj/horn_tool/main.c.o $bin/lib/libhorn.a $bin/lib/liberror.a $bin/lib/libassoc.a $bin/lib/libpgm.a
  flags =

build $bin/obj/iron_tool/main.c.o: cc src/iron_tool/main.c
  flags = -fPIE  
build $bin/bin/iron_tool: link $bin/obj/iron_tool/main.c.o $bin/lib/libhorn.a $bin/lib/liberror.a $bin/lib/libassoc.a $bin/lib/libpgm.a
  flags = -Wl,--export-dynamic -ldl

build $bin/obj/bee_tool/main.c.o: cc src/bee_tool/main.c
  flags = -fPIE  
build $bin/bin/bee_tool: link $bin/obj/bee_tool/main.c.o $bin/lib/libhorn.a $bin/lib/liberror.a $bin/lib/libassoc.a $bin/lib/libpgm.a
  flags = -Wl,--export-dynamic -ldl

build $bin/obj/trsc/main.c.o: cc src/trsc/main.c
  flags = -fPIE 
build $bin/bin/trsc: link $bin/obj/trsc/main.c.o $bin/lib/liberror.a $bin/lib/libhorn.a $bin/lib/libassoc.a $bin/lib/libpgm.a
  flags = -ldl

build test: phony $bin/test/ap $bin/test/vec $bin/test/vec_int $bin/test/assoc $bin/test/assoc_int $bin/test/pgm
build $bin/test/ap: testc test/ap.c $bin/lib/libap.a
build $bin/test/vec: testc test/vec.c $bin/lib/libvec.a
build $bin/test/vec_int: testc test/vec_int.c $bin/lib/libvec.a
build $bin/test/assoc: testc test/assoc.c $bin/lib/libassoc.a
build $bin/test/assoc_int: testc test/assoc_int.c $bin/lib/libassoc.a
build $bin/test/pgm: testc test/pgm.c $bin/lib/libpgm.a
